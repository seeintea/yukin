{
  "name": "yukin",
  "version": "0.0.1",
  "description": "Electron + Go Local AI Agent",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "tsc -p . && electron .",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tanstack/react-router": "^1.114.0",
    "@tanstack/react-router-devtools": "^1.114.0",
    "@tanstack/router-plugin": "^1.114.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.2",
    "@prettier/plugin-oxc": "^0.1.0",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.yukin.app",
    "productName": "yukin",
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      {
        "from": "resources/bin/agent",
        "to": "bin/agent"
      }
    ],
    "files": [
      "src/**/*",
      "dist/**/*"
    ]
  }
}
